generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SwipeDirection {
  YES @map("yes")
  NO @map("no")
}

enum MatchStatus {
  PENDING
  ACTIVE
  BLOCKED
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  createdAt DateTime   @default(now())
  profile   Profile?
  sessions  Session[]
  otpTokens OtpToken[]
  analyticsEvents AnalyticsEvent[]
  gameWebsiteClicks GameWebsiteClick[] @relation("UserGameWebsiteClick")
}

model Profile {
  id           String        @id @default(uuid())
  userId       String        @unique
  name         String
  avatarUrl    String?
  bio          String?       @db.VarChar(200)
  twitterLink  String?
  redditLink   String?
  gamePref     String?       @db.VarChar(64)
  gamePreferences String[]   @default([]) @db.VarChar(64)
  timeSlot     String?       @db.VarChar(64)
  timeSlots    String[]      @default([]) @db.VarChar(64)
  language     String?       @db.VarChar(64)
  playstyle    String?       @db.VarChar(64)
  inviteCode   String?       @db.VarChar(64)
  theme        String?       @default("system") @db.VarChar(16)
  notifyOnNewMatch   Boolean @default(true)
  notifyOnNewMessage Boolean @default(true)
  notifyOnAnnouncements Boolean @default(true)
  isVerified   Boolean       @default(false)
  isShadowbanned Boolean     @default(false)
  isChild      Boolean       @default(false)
  isAdmin      Boolean       @default(false)
  guardianProfileId String?
  exp          Int           @default(0)
  level        Int           @default(1)
  lastDailyLogin DateTime?
  referralCode String?       @unique
  referredById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  swipesGiven  Swipe[]       @relation("SwipeSwiper")
  swipesTaken  Swipe[]       @relation("SwipeSwiped")
  matchesAsOne Match[]       @relation("MatchUser1")
  matchesAsTwo Match[]       @relation("MatchUser2")
  messages     Message[]
  guilds       GuildMembership[]
  guildsOwned  Guild[]       @relation("GuildOwner")
  guildMessages GuildMessage[]
  guildCreationCodes GuildCreationCode[] @relation("GuildCodeCreator")
  guardian     Profile?      @relation("GuardianChildren", fields: [guardianProfileId], references: [id], onDelete: SetNull)
  children     Profile[]     @relation("GuardianChildren")
  matchApprovals Match[]     @relation("GuardianMatchApproval")
  matchBlocks   Match[]      @relation("GuardianMatchBlock")
  badgeCollections ProfileBadge[]
  guildEventsCreated GuildEvent[] @relation("GuildEventCreator")
  guildEventAlerts   GuildEventAlert[] @relation("GuildEventAlertSubscription")
  guildInvitesCreated GuildQrInvite[] @relation("GuildInviteCreator")
  redeemedGuildCodes GuildCreationCode[] @relation("GuildCodeRedeemer")
  guildPayments       GuildCreationPayment[] @relation("GuildPaymentPayer")
  preferredGame     Game?            @relation("ProfileGame", fields: [gamePref], references: [value])
  preferredTimeSlot TimeSlotOption?  @relation("ProfileTimeSlot", fields: [timeSlot], references: [value])
  preferredLanguage LanguageOption?  @relation("ProfileLanguage", fields: [language], references: [value])
  preferredPlaystyle PlaystyleOption? @relation("ProfilePlaystyle", fields: [playstyle], references: [value])
  analyticsEvents AnalyticsEvent[]
  feedback Feedback[]
  gameRatings GameRating[] @relation("ProfileGameRating")
  gameComments GameComment[] @relation("ProfileGameComment")
  expEvents ExpEvent[] @relation("ProfileExpEvents")
  referrals Referral[] @relation("ReferrerProfile")
  referredBy Profile? @relation("ProfileReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredProfiles Profile[] @relation("ProfileReferrals")
  aiConversation AiConversation?
  inviteClaims InviteCode[] @relation("InviteCodeClaimer")
  gameWebsiteClicks GameWebsiteClick[] @relation("ProfileGameWebsiteClick")
  suggestionsCreated GameSuggestion[] @relation("SuggestionAuthor")
  suggestionsHandled GameSuggestion[] @relation("SuggestionHandler")
  gameUpdateSuggestionsCreated GameUpdateSuggestion[] @relation("GameUpdateAuthor")
  gameUpdateSuggestionsHandled GameUpdateSuggestion[] @relation("GameUpdateHandler")
  inviteCodeUsages InviteCodeUsage[] @relation("InviteCodeUsages")
}

model InviteCode {
  id                 String              @id @default(uuid())
  code               String              @unique @db.VarChar(32)
  maxUses            Int                 @default(1)
  usageCount         Int                 @default(0)
  createdAt          DateTime            @default(now())
  claimedAt          DateTime?
  claimedByProfileId String?             @unique

  claimedBy          Profile?            @relation("InviteCodeClaimer", fields: [claimedByProfileId], references: [id], onDelete: SetNull)
  usageLogs          InviteCodeUsage[]

  @@index([code, usageCount, maxUses])
}

model InviteCodeUsage {
  id             String     @id @default(uuid())
  inviteCodeId   String
  profileId      String
  usedAt         DateTime   @default(now())

  inviteCode     InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  profile        Profile    @relation("InviteCodeUsages", fields: [profileId], references: [id], onDelete: Cascade)

  @@index([inviteCodeId])
  @@index([profileId])
  @@index([usedAt])
}

model GameCategory {
  id          String   @id @default(uuid())
  value       String   @unique @db.VarChar(64)
  label       String   @db.VarChar(128)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  games       Game[]   @relation("GameCategory")
}

model Game {
  value       String        @id @db.VarChar(64)
  label       String        @db.VarChar(128)
  description String?       @db.VarChar(5000)
  screenshot  String?       @db.VarChar(500)
  website     String?       @db.VarChar(500)
  summary     String?       @db.VarChar(1500)
  featureSummary String?    @db.VarChar(2000)
  genreTags   String[]      @default([])
  platformTags String[]     @default([])
  gameplayTags String[]     @default([])
  worldTags   String[]      @default([])
  visualStyleTags String[]  @default([])
  monetization String?      @db.VarChar(200)
  idealFor    String?       @db.VarChar(500)
  systemRequirements Json?
  ragProfile  Json?
  sourceUrls  Json?
  categoryId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  // Vector embedding fields for semantic search
  embedding   Unsupported("vector(1536)")?
  embeddingModel String?    @db.VarChar(50)
  embeddingGeneratedAt DateTime?

  category    GameCategory? @relation("GameCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  profiles    Profile[]     @relation("ProfileGame")
  ratings     GameRating[]
  comments    GameComment[]
  websiteClicks GameWebsiteClick[]
  updateSuggestions GameUpdateSuggestion[]

  @@index([categoryId])
  @@index([embeddingGeneratedAt])
}

enum GameSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model GameSuggestion {
  id                  String                @id @default(uuid())
  title               String                @db.VarChar(150)
  description         String?               @db.VarChar(2000)
  referenceUrl        String?               @db.VarChar(500)
  status              GameSuggestionStatus  @default(PENDING)
  adminNotes          String?               @db.VarChar(1000)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  handledAt           DateTime?
  createdByProfileId  String
  handledByProfileId  String?

  createdBy Profile @relation("SuggestionAuthor", fields: [createdByProfileId], references: [id], onDelete: Cascade)
  handledBy Profile? @relation("SuggestionHandler", fields: [handledByProfileId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}

model GameUpdateSuggestion {
  id                  String                @id @default(uuid())
  gameValue           String                @db.VarChar(64)
  payload             Json                  @db.Json
  comment             String?               @db.VarChar(1000)
  status              GameSuggestionStatus  @default(PENDING)
  adminNotes          String?               @db.VarChar(1000)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  handledAt           DateTime?
  createdByProfileId  String
  handledByProfileId  String?

  game       Game    @relation(fields: [gameValue], references: [value], onDelete: Cascade)
  createdBy Profile @relation("GameUpdateAuthor", fields: [createdByProfileId], references: [id], onDelete: Cascade)
  handledBy Profile? @relation("GameUpdateHandler", fields: [handledByProfileId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([gameValue])
}

model GameWebsiteClick {
  id        String   @id @default(uuid())
  gameValue String   @db.VarChar(64)
  profileId String?
  userId    String?
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  game    Game     @relation(fields: [gameValue], references: [value], onDelete: Cascade)
  profile Profile? @relation("ProfileGameWebsiteClick", fields: [profileId], references: [id], onDelete: SetNull)
  user    User?    @relation("UserGameWebsiteClick", fields: [userId], references: [id], onDelete: SetNull)

  @@index([gameValue])
  @@index([profileId])
  @@index([createdAt])
}

model GameRating {
  id        String   @id @default(uuid())
  gameValue String   @db.VarChar(64)
  profileId String
  rating    Int      @db.SmallInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game    Game    @relation(fields: [gameValue], references: [value], onDelete: Cascade)
  profile Profile @relation("ProfileGameRating", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([gameValue, profileId])
  @@index([gameValue])
}

model GameComment {
  id        String   @id @default(uuid())
  gameValue String   @db.VarChar(64)
  profileId String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game    Game    @relation(fields: [gameValue], references: [value], onDelete: Cascade)
  profile Profile @relation("ProfileGameComment", fields: [profileId], references: [id], onDelete: Cascade)

  @@index([gameValue])
  @@index([profileId])
}

model TimeSlotOption {
  value    String   @id @db.VarChar(64)
  label    String   @db.VarChar(128)
  profiles Profile[] @relation("ProfileTimeSlot")
}

model LanguageOption {
  value    String   @id @db.VarChar(64)
  label    String   @db.VarChar(128)
  icon     String?  @db.VarChar(16)
  profiles Profile[] @relation("ProfileLanguage")
}

model PlaystyleOption {
  value    String   @id @db.VarChar(64)
  label    String   @db.VarChar(128)
  profiles Profile[] @relation("ProfilePlaystyle")
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String   @db.VarChar(64)
  profileId String?
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([userId])
  @@index([eventType])
}

model Feedback {
  id        String   @id @default(uuid())
  profileId String
  message   String   @db.Text
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Swipe {
  id        String         @id @default(uuid())
  swiperId  String
  swipedId  String
  direction SwipeDirection
  createdAt DateTime       @default(now())

  swiper Profile @relation("SwipeSwiper", fields: [swiperId], references: [id], onDelete: Cascade)
  swiped Profile @relation("SwipeSwiped", fields: [swipedId], references: [id], onDelete: Cascade)

  @@unique([swiperId, swipedId])
}

model Match {
  id       String   @id @default(uuid())
  user1Id  String
  user2Id  String
  status   MatchStatus @default(ACTIVE)
  requiresGuardianApproval Boolean @default(false)
  approvedByProfileId String?
  approvedAt DateTime?
  blockedByProfileId String?
  blockedAt DateTime?
  user1LastViewedAt DateTime?
  user2LastViewedAt DateTime?
  createdAt DateTime @default(now())

  user1 Profile @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 Profile @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages Message[]
  guardianApprover Profile? @relation("GuardianMatchApproval", fields: [approvedByProfileId], references: [id], onDelete: SetNull)
  guardianBlocker Profile? @relation("GuardianMatchBlock", fields: [blockedByProfileId], references: [id], onDelete: SetNull)

  @@unique([user1Id, user2Id])
}

model Message {
  id        String   @id @default(uuid())
  matchId   String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  match  Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender Profile @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpToken {
  id         String   @id @default(uuid())
  userId     String
  email      String
  tokenHash  String
  expiresAt  DateTime
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum GuildRole {
  OWNER
  OFFICER
  MEMBER
}

model Guild {
  id          String            @id @default(uuid())
  name        String            @db.VarChar(80)
  description String?           @db.VarChar(250)
  ownerId     String
  inviteCode  String            @unique @db.VarChar(16)
  creationCodeId String         @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  owner   Profile @relation("GuildOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  creationCode GuildCreationCode @relation("GuildCreation", fields: [creationCodeId], references: [id], onDelete: Cascade)
  members GuildMembership[]
  messages GuildMessage[]
  invites  GuildQrInvite[]
  events   GuildEvent[]
}

model GuildMembership {
  id        String    @id @default(uuid())
  guildId   String
  profileId String
  role      GuildRole @default(MEMBER)
  nickname  String?   @db.VarChar(80)
  isBlockedByGuardian Boolean @default(false)
  createdAt DateTime  @default(now())

  guild   Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([guildId, profileId])
}

enum GuildEventLocationType {
  ONLINE
  OFFLINE
}

enum GuildEventAlertChannel {
  EMAIL
  SMS
  DISCORD
  TELEGRAM
}

model GuildEvent {
  id          String   @id @default(uuid())
  guildId     String
  title       String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  locationType GuildEventLocationType @default(ONLINE)
  locationDetail String? @db.VarChar(200)
  startsAt     DateTime
  imageUrl     String? @db.VarChar(250)
  createdByProfileId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guild   Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  creator Profile @relation("GuildEventCreator", fields: [createdByProfileId], references: [id], onDelete: Cascade)
  alerts  GuildEventAlert[]
}

model GuildEventAlert {
  id        String                 @id @default(uuid())
  eventId   String
  profileId String
  channel   GuildEventAlertChannel
  createdAt DateTime              @default(now())

  event   GuildEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile Profile    @relation("GuildEventAlertSubscription", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([eventId, profileId, channel])
}

model Badge {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(60)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(280)
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  radiusMeters Int     @default(50)
  qrSecret    String?  @db.VarChar(64)
  qrRequired  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  collections ProfileBadge[]
}

model ProfileBadge {
  id         String   @id @default(uuid())
  profileId  String
  badgeId    String
  collectedAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  badge   Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([profileId, badgeId])
}

model GuildQrInvite {
  id          String   @id @default(uuid())
  guildId     String
  code        String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  createdById String?

  guild      Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdBy  Profile? @relation("GuildInviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

model GuildMessage {
  id        String   @id @default(uuid())
  guildId   String
  senderId  String
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())

  guild   Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  sender  Profile @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

enum AiMessageRole {
  USER
  ASSISTANT
}

model AiConversation {
  id        String   @id @default(uuid())
  profileId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  messages AiMessage[]
}

model AiMessage {
  id              String        @id @default(uuid())
  conversationId  String
  role            AiMessageRole
  content         String        @db.Text

  // Intent detection fields (only for USER messages)
  intent          String?       @db.VarChar(64)
  intentConfidence Float?
  intentEntities  Json?

  createdAt       DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([intent])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

model GuildCreationCode {
  id          String            @id @default(uuid())
  code        String            @unique
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  redeemedAt  DateTime?
  redeemedByProfileId String?
  createdByProfileId  String?

  payment GuildCreationPayment?
  guild   Guild?              @relation("GuildCreation")

  redeemedBy Profile? @relation("GuildCodeRedeemer", fields: [redeemedByProfileId], references: [id], onDelete: SetNull)
  createdBy Profile? @relation("GuildCodeCreator", fields: [createdByProfileId], references: [id], onDelete: SetNull)
}

model GuildCreationPayment {
  id             String         @id @default(uuid())
  codeId         String         @unique
  chainId        Int
  tokenAddress   String?
  payerAddress   String
  amountWei      String
  txHash         String         @unique
  status         PaymentStatus  @default(PENDING)
  createdAt      DateTime       @default(now())
  confirmedAt    DateTime?
  payerProfileId String?

  code  GuildCreationCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  payer Profile?          @relation("GuildPaymentPayer", fields: [payerProfileId], references: [id], onDelete: SetNull)
}

enum ExpEventType {
  OAUTH_VERIFICATION
  STEAM_IMPORT
  DAILY_LOGIN
  MESSAGE_SENT
  PROFILE_COMPLETE
  FIRST_MATCH
  GUILD_JOIN
  GAME_RATING
  GAME_COMMENT
  REFERRAL_SIGNUP
  REFERRAL_BONUS
}

model ExpEvent {
  id         String       @id @default(uuid())
  profileId  String
  eventType  ExpEventType
  expGained  Int
  metadata   Json?
  createdAt  DateTime     @default(now())

  profile Profile @relation("ProfileExpEvents", fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([profileId, eventType])
}

enum ReferralStatus {
  PENDING
  COMPLETED
  REWARDED
}

model Referral {
  id            String         @id @default(uuid())
  referrerId    String
  referredId    String?
  referralCode  String
  status        ReferralStatus @default(PENDING)
  visitedAt     DateTime       @default(now())
  completedAt   DateTime?
  rewardedAt    DateTime?
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  referrer Profile  @relation("ReferrerProfile", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referralCode])
  @@index([referrerId])
  @@index([referredId])
  @@index([status])
}
